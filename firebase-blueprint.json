{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and educational preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "format": "email", "description": "User's email" },
        "school": { "type": "string", "description": "User's school/university" },
        "grade": { "type": "string", "enum": ["Regional", "Baccalaureate", "1st Year University"], "description": "User's current grade level" },
        "subjects": { "type": "array", "items": { "type": "string" }, "description": "Subjects the user is studying" },
        "studyTimes": { "type": "array", "items": { "type": "string" }, "description": "Preferred study hours (e.g., 'Morning', 'Afternoon', 'Evening')" },
        "points": { "type": "integer", "description": "Total points earned" },
        "streak": { "type": "integer", "description": "Current daily streak" },
        "level": { "type": "integer", "description": "User's current level" },
        "badges": { "type": "array", "items": { "type": "string" }, "description": "Array of earned badge IDs" },
        "lastActive": { "type": "string", "format": "date-time", "description": "Last time the user was active" },
        "onboardingCompleted": { "type": "boolean", "description": "Whether the user has completed onboarding" }
      },
      "required": ["uid", "displayName", "email", "onboardingCompleted"]
    },
    "Challenge": {
      "title": "Challenge",
      "description": "A daily educational task",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Challenge ID" },
        "title": { "type": "string", "description": "Challenge title" },
        "description": { "type": "string", "description": "Challenge description" },
        "points": { "type": "integer", "description": "Points awarded for completion" },
        "type": { "type": "string", "enum": ["study", "quiz", "social"], "description": "Type of challenge" },
        "grade": { "type": "string", "description": "Target grade level (optional)" },
        "likes": { "type": "array", "items": { "type": "string" }, "description": "Array of user IDs who liked this challenge" }
      },
      "required": ["id", "title", "description", "points", "type"]
    },
    "UserChallenge": {
      "title": "UserChallenge",
      "description": "Tracking user progress on a challenge",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID" },
        "challengeId": { "type": "string", "description": "Challenge ID" },
        "completed": { "type": "boolean", "description": "Whether the challenge is completed" },
        "completedAt": { "type": "string", "format": "date-time", "description": "When the challenge was completed" },
        "date": { "type": "string", "format": "date", "description": "The date for this challenge" }
      },
      "required": ["userId", "challengeId", "completed", "date"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/challenges/{challengeId}": {
      "schema": "Challenge",
      "description": "Global challenges list"
    },
    "/userChallenges/{userChallengeId}": {
      "schema": "UserChallenge",
      "description": "User-specific challenge progress"
    }
  }
}
